# AegisMCP Environment Configuration
# Copy to .env and fill in your values

# AWS Bedrock (optional — fallback router works without credentials)
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# MCP Server
AEGIS_MCP_URL=http://127.0.0.1:8000/mcp
AEGIS_HOST_PORT=8080
AEGIS_MCP_PORT=8000

# Home Assistant Hardware Bridge (Matter / Zigbee / Z-Wave) (Optional - falls back to SIMULATED)
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your_long_lived_access_token_here
# HASS_WATER_VALVE_ENTITY=valve.main_water_shutoff
# HASS_GAS_VALVE_ENTITY=valve.main_gas_shutoff

# Carrier Intelligence & SMS Caregiver Alerting (Optional - falls back to local heuristic/logs)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# NUMVERIFY_API_KEY=
# CAREGIVER_PHONE=+15550198822
# CAREGIVER_NAME="Primary Caregiver"
# CAREGIVER_WEBHOOK_URL=

