# AegisMCP Environment Configuration
# Copy to .env and fill in your values

# AWS Bedrock (optional — fallback router works without credentials)
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# MCP Server
AEGIS_MCP_URL=http://127.0.0.1:8000/mcp
AEGIS_HOST_PORT=8080
AEGIS_MCP_PORT=8000
